# ============================================================
#  WhatsApp Agent System — Environment Variables
#  Copy this file to .env and fill in your values:
#      cp .env.example .env
#  The installer (install.sh) creates this for you automatically.
#  NEVER commit the real .env — it is gitignored for a reason.
# ============================================================

# ─── Gemini API (optional) ──────────────────────────────────
# Get a free key at https://aistudio.google.com/
# Leave blank to use the built-in canned Auto Pilot replies.
GEMINI_API_KEY=

# ─── Authorized WhatsApp Numbers ────────────────────────────
# Comma-separated, include country code without '+', e.g. 15551234567
# Leave blank to allow every incoming chat.
ADMIN_NUMBERS=

# ─── Agent Chat Trigger ─────────────────────────────────────
AGENT_CHAT_NAME=Agent
COMMAND_PREFIX=!
BOSS_NAME=my boss

# ─── Dashboard ──────────────────────────────────────────────
# Browse to http://<server-ip>:5050 after installing.
DASHBOARD_PORT=5050
DASHBOARD_HOST=0.0.0.0
DASHBOARD_SECRET=change_this_to_a_strong_secret

# ─── Dashboard login ────────────────────────────────────────
# The browser will prompt for these. install.sh generates a random password
# and prints it at the end; leave BOTH blank to disable the login (not advised
# — the archive holds every chat and is reachable from the internet).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# ─── Browser (Puppeteer) ─────────────────────────────────────
# Windows local dev (Edge, visible window):
#   HEADLESS=false
#   BROWSER_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
#
# Linux server (Chrome, headless) — install.sh fills these in for you:
HEADLESS=true
BROWSER_PATH=/usr/bin/google-chrome

# ─── Email — Gmail API (OAuth2, optional) ───────────────────
# Run `node get-token.js` once to obtain these three values.
# No SMTP password is used or required.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ─── Weather API (optional — OpenWeatherMap free tier) ──────
WEATHER_API_KEY=
WEATHER_DEFAULT_CITY=New York

# ─── CoinGecko (no key needed, but rate-limited) ────────────
CRYPTO_DEFAULT=bitcoin,ethereum,solana

# ─── Logging ────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs

# ─── Storage ────────────────────────────────────────────────
# Defaults to SQLite (data/vampire.db) — no server required.
DB_USE_MYSQL=false
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=vampire

# ─── Nmap / Security ────────────────────────────────────────
# Whitelist of IPs/subnets that nmap is ALLOWED to scan
NMAP_ALLOWED_TARGETS=127.0.0.1

# ─── Shell Command Whitelist ─────────────────────────────────
# Additional commands beyond the built-in list (comma-separated)
EXTRA_ALLOWED_CMDS=
