{
  "name": "whatsapp-agent-system",
  "version": "1.0.0",
  "description": "WhatsApp Web AI agent with Gemini NLP, dashboard, email, and server task management.",
  "main": "start.js",
  "scripts": {
    "start": "node start.js",
    "bot": "node src/bot/index.js",
    "dashboard": "node src/dashboard/index.js",
    "dev": "nodemon start.js",
    "test": "node --test tests/revoke.test.js tests/browserLock.test.js tests/messageFilter.test.js tests/mediaDownloader.test.js",
    "test:live": "node --test tests/dashboard.live.test.js",
    "test:all": "node --test tests/revoke.test.js tests/browserLock.test.js tests/messageFilter.test.js tests/mediaDownloader.test.js tests/dashboard.live.test.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop all",
    "pm2:restart": "pm2 restart all",
    "pm2:logs": "pm2 logs"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.2.0",
    "googleapis": "^172.0.0",
    "mysql2": "^3.11.0",
    "nodemailer": "^6.9.15",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.0",
    "sql.js": "^1.14.1",
    "systeminformation": "^5.31.6",
    "whatsapp-web.js": "^1.34.7",
    "winston": "^3.16.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "socket.io-client": "^4.8.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "gemini",
    "ai",
    "agent",
    "dashboard",
    "nodejs"
  ],
  "license": "MIT"
}
